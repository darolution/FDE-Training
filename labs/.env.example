# Copy to labs/.env and fill in.  labs/.env is git-ignored - never commit it.

# --- Claude API ---------------------------------------------------------
# Create a key for this course only (Console -> API keys) and set a monthly
# spend limit on its workspace before you start.
ANTHROPIC_API_KEY=

# Models used by the labs. IDs verified 2026-10-06 - see docs/reference/models.md
FDE_MODEL_FAST=claude-haiku-4-5-20251001
FDE_MODEL_DEFAULT=claude-sonnet-5-5
FDE_MODEL_BEST=claude-opus-5-5

# --- Local Splunk lab (Docker) -------------------------------------------
# Lab data only. Never point these at an employer Splunk instance.
SPLUNK_HOST=localhost
SPLUNK_MGMT_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=fde_lab

# The Docker image uses a self-signed certificate. The labs only allow
# skipping TLS verification when SPLUNK_HOST is a loopback address.
SPLUNK_VERIFY_TLS=false
